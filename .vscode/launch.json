        "JAVA_HOME": "${workspaceFolder}\\.toolchain\\jdk17",
        "ANDROID_HOME": "${workspaceFolder}\\.toolchain\\android-sdk",
        "ANDROID_SDK_ROOT": "${workspaceFolder}\\.toolchain\\android-sdk",
        "PUB_CACHE": "${workspaceFolder}\\.toolchain\\pub-cache",
        "GRADLE_USER_HOME": "${workspaceFolder}\\.toolchain\\gradle-cache"
      }
    },
    {
